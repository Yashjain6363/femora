// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  periodEntries   PeriodEntry[]
  cravingEntries  CravingEntry[]
  symptomEntries  SymptomEntry[]
  wellnessEntries WellnessEntry[]
  appointments    Appointment[]
  reminders       Reminder[]

  @@index([email])
}

// ─────────────────────────────────────────────
// PERIOD ENTRY
// ─────────────────────────────────────────────
model PeriodEntry {
  id        String    @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime?
  flow      FlowLevel @default(MEDIUM)
  painLevel Int       @default(0) // 0-10 scale
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate])
}

enum FlowLevel {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
  VERY_HEAVY
}

// ─────────────────────────────────────────────
// CRAVING ENTRY
// ─────────────────────────────────────────────
model CravingEntry {
  id        String          @id @default(cuid())
  userId    String
  food      String
  category  CravingCategory
  intensity Int             // 1-5 scale
  mood      String?
  notes     String?
  loggedAt  DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
}

enum CravingCategory {
  SWEET
  SALTY
  SOUR
  SPICY
  FATTY
  CARBS
  PROTEIN
  DAIRY
  FRUITS
  OTHER
}

// ─────────────────────────────────────────────
// SYMPTOM ENTRY
// ─────────────────────────────────────────────
model SymptomEntry {
  id        String      @id @default(cuid())
  userId    String
  symptom   SymptomType
  severity  Int         // 1-5 scale
  notes     String?
  loggedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
}

enum SymptomType {
  CRAMPS
  HEADACHE
  FATIGUE
  BLOATING
  ACNE
  BACK_PAIN
  BREAST_TENDERNESS
  NAUSEA
  MOOD_SWINGS
  INSOMNIA
  OTHER
}

// ─────────────────────────────────────────────
// WELLNESS ENTRY (daily snapshot)
// ─────────────────────────────────────────────
model WellnessEntry {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date // one per day
  sleepHours   Float?   // hours slept
  mood         Int?     // 1-5 scale
  energyLevel  Int?     // 1-5 scale
  stressLevel  Int?     // 1-5 scale
  waterIntake  Float?   // litres
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
}

// ─────────────────────────────────────────────
// APPOINTMENT
// ─────────────────────────────────────────────
model Appointment {
  id          String            @id @default(cuid())
  userId      String
  title       String
  date        DateTime
  provider    String?
  location    String?
  notes       String?
  status      AppointmentStatus @default(UPCOMING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// REMINDER
// ─────────────────────────────────────────────
model Reminder {
  id        String   @id @default(cuid())
  userId    String
  message   String
  remindAt  DateTime
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, remindAt])
}
