{
  "name": "hercare-backend",
  "version": "1.0.0",
  "description": "HerCare Wellness Platform - Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "node .\\node_modules\\prisma\\build\\index.js generate",
    "db:migrate": "node .\\node_modules\\prisma\\build\\index.js migrate dev",
    "db:migrate:prod": "node .\\node_modules\\prisma\\build\\index.js migrate deploy",
    "db:studio": "node .\\node_modules\\prisma\\build\\index.js studio",
    "db:reset": "node .\\node_modules\\prisma\\build\\index.js migrate reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
